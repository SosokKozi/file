<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Проверка, что код Unity компилируется, без установленного Unity.
    Справочные сборки UnityEngine 2021.3 из NuGet; новые API Unity 6 в коде не используем.
      dotnet build tools/CompileCheck                       — старый ввод (Input Manager)
      dotnet build tools/CompileCheck -p:NewInput=true      — новая система ввода (заглушка в Stubs/)
    Это проверка компиляции, а не запуск: поведение проверяется в редакторе.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
    <DefineConstants Condition="'$(NewInput)' == 'true'">$(DefineConstants);ENABLE_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Code/Sim/**/*.cs" />
    <Compile Include="../../Assets/_Project/Code/Game/**/*.cs" />
    <Compile Include="../../Assets/_Project/Code/Editor/**/*.cs" />
    <Compile Include="Stubs/InputSystemStub.cs" Condition="'$(NewInput)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Unity3D.SDK" Version="2021.1.14.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UnityEditor">
      <HintPath>$(PkgUnity3D_SDK)/lib/UnityEditor.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
